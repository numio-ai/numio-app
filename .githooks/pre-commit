#!/usr/bin/env bash
# Pre-commit hook: block commits containing secrets (keys, tokens, passwords).
#
# Enrolled per-checkout by `./scripts/numio-dev.sh init`, which sets
# `git config core.hooksPath .githooks`. Runs gitleaks against the staged
# diff only; a finding aborts the commit.
#
# Fail-closed: if gitleaks is not installed, the commit is refused rather
# than silently skipped.

set -u


if ! command -v gitleaks &>/dev/null; then
  echo "[pre-commit] gitleaks is not installed — refusing to commit unscanned changes." >&2
  echo "[pre-commit] Install it and retry:  brew install gitleaks" >&2
  echo "[pre-commit] (or see https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi

echo "[pre-commit] Scanning staged changes for secrets (gitleaks)..."
gitleaks git --pre-commit --staged --redact --verbose --no-banner
status=$?

if [ "${status}" -eq 0 ]; then
  echo "[pre-commit] OK — no secrets detected, commit allowed."
else
  echo "[pre-commit] BLOCKED — gitleaks detected potential secrets in staged changes." >&2
  echo "[pre-commit] Remove or unstage the flagged lines. For a documented dummy value, append '# gitleaks:allow' on that line." >&2
fi

exit "${status}"
