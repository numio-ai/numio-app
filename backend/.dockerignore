# Keep .env and local state out of the build context.
# Defense-in-depth with the CI leak-guard step.
.env
.env.*
!.env.example

# Python / uv local state
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Local dev state (numio-dev.sh)
.numio/

# Tests and fixtures — not needed at runtime
tests/

# Git
.git/
.gitignore
