# Numio localhost environment configuration
#
# This file is a reference template. It is NOT consumed by docker compose
# directly — the base docker-compose.yml has all values hardcoded.
#
# If you need to override settings for native dev servers, create
# backend/.env with the relevant variables (e.g., DATABASE_URL).

# Backend configuration
LOG_LEVEL=DEBUG

# MCP configuration
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Numio API (optional - for local testing)
# NUMIO_API_KEY=your-api-key-here

# AWS onboarding
# Enable the Chat-driven onboarding method on the Add Account hub.
# Off in production; recommended on in local dev and QA for feedback.
ONBOARDING_CHAT_ENABLED=true
